# The database leader through PgBouncer: what the app writes to
DATABASE_URL="postgres://root:mysecretpassword@localhost:6432/local"
# Standbys through PgBouncer: what redirect lookups read
DATABASE_READ_URL="postgres://root:mysecretpassword@localhost:6432/local_ro"
# The database leader, bypassing the pooler: what migrations use
DATABASE_DIRECT_URL="postgres://root:mysecretpassword@localhost:5433/local"

# Valkey (redirect cache)
VALKEY_URL="redis://localhost:6379"
